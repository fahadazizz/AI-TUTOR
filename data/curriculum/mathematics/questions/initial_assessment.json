    {
      "question_id": "math10.assess.q15",
      "concept_id": "math10.ch2.word_problems",
      "difficulty": 4,
      "question_type": "word_problem",
      "question_text_ur": "اگر کسی مثبت عدد کے مربع میں اسی عدد کا دگنا (2x) جمع کیا جائے تو جواب 35 آتا ہے۔ عدد معلوم کرو۔",
      "question_text_en": "If twice a positive number is added to its square, the result is 35. Find the number.",
      "expected_answer": "$5$",
      "answer_tolerance": null,
      "expected_answer_unit": null,
      "solution_steps": [
        {
          "step": 1,
          "description_ur": "عدد کو x مان لو",
          "math": "$x$"
        },
        {
          "step": 2,
          "description_ur": "شرط کے مطابق مساوات بناؤ",
          "math": "$x^2 + 2x = 35$"
        },
        {
          "step": 3,
          "description_ur": "معیاری شکل میں لاؤ",
          "math": "$x^2 + 2x - 35 = 0$"
        },
        {
          "step": 4,
          "description_ur": "تحلیل کرو",
          "math": "$(x+7)(x-5) = 0$"
        },
        {
          "step": 5,
          "description_ur": "مثبت عدد لینا ہے، اس لیے x = 5",
          "math": "$x = 5$"
        }
      ],
      "hints": [],
      "tags": [
        "assessment",
        "word_problem"
      ]
