    {
      "question_id": "math10.assess.q11",
      "concept_id": "math10.ch2.discriminant",
      "difficulty": 2,
      "question_type": "procedural",
      "question_text_ur": "مساوات x^2 + 2x - 3 = 0 کا ممیز (discriminant) نکالو۔",
      "question_text_en": "Calculate the discriminant of the equation x^2 + 2x - 3 = 0.",
      "expected_answer": "$16$",
      "answer_tolerance": null,
      "expected_answer_unit": null,
      "solution_steps": [
        {
          "step": 1,
          "description_ur": "a, b, c نکالو",
          "math": "$a=1, b=2, c=-3$"
        },
        {
          "step": 2,
          "description_ur": "فارمولا استعمال کرو: D = b^2 - 4ac",
          "math": "$D = (2)^2 - 4(1)(-3)$"
        },
        {
          "step": 3,
          "description_ur": "حل کرو",
          "math": "$D = 4 - (-12) = 4 + 12 = 16$"
        }
      ],
      "hints": [],
      "tags": [
        "assessment",
        "discriminant"
      ]
    },
