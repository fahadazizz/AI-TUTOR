    {
      "question_id": "math10.assess.q14",
      "concept_id": "math10.ch2.quadratic_formula",
      "difficulty": 4,
      "question_type": "procedural",
      "question_text_ur": "x^2 - 4x - 5 = 0 کو مربعی فارمولے سے حل کرو۔",
      "question_text_en": "Solve x^2 - 4x - 5 = 0 using the quadratic formula.",
      "expected_answer": "$x = 5, x = -1$",
      "answer_tolerance": null,
      "expected_answer_unit": null,
      "solution_steps": [
        {
          "step": 1,
          "description_ur": "a=1, b=-4, c=-5",
          "math": ""
        },
        {
          "step": 2,
          "description_ur": "فارمولے میں رکھو",
          "math": "$x = (4 ± √(16 - 4(1)(-5))) / 2$"
        },
        {
          "step": 3,
          "description_ur": "حل کرو",
          "math": "$x = (4 ± √36) / 2 = (4 ± 6) / 2$"
        },
        {
          "step": 4,
          "description_ur": "جواب نکالو",
          "math": "$x = 10/2 = 5 یا x = -2/2 = -1$"
        }
      ],
      "hints": [],
