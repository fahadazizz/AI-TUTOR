    {
      "question_id": "math10.assess.q10",
      "concept_id": "math10.ch2.solving_by_factorization",
      "difficulty": 3,
      "question_type": "procedural",
      "question_text_ur": "x^2 - 8x + 15 = 0 کی جڑیں (roots) تحلیل (factorization) سے معلوم کرو۔",
      "question_text_en": "Find the roots of x^2 - 8x + 15 = 0 by factorization.",
      "expected_answer": "$x = 3, x = 5$",
      "answer_tolerance": null,
      "expected_answer_unit": null,
      "solution_steps": [
        {
          "step": 1,
          "description_ur": "ایسے عدد تلاش کرو جن کی ضرب 15 اور جمع -8 ہو",
          "math": "$(-3) \\times (-5) = 15, (-3) + (-5) = -8$"
        },
        {
          "step": 2,
          "description_ur": "تحلیل کرو",
          "math": "$(x-3)(x-5) = 0$"
        },
        {
          "step": 3,
          "description_ur": "حل کرو",
          "math": "$x = 3, x = 5$"
        }
      ],
      "hints": [],
      "tags": [
        "assessment",
        "solving_by_factorization"
      ]
