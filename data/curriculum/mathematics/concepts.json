    {
      "concept_id": "prereq.numbers.negative_numbers",
      "subject": "mathematics",
      "chapter": 0,
      "chapter_name": "Prerequisites (Class 9 & Earlier)",
      "name_en": "Operations with Negative Numbers",
      "name_ur": "منفی اعداد کے ساتھ عملیات",
      "difficulty": 1,
      "pedagogy_type": "conceptual",
      "learning_objectives": [
        "Multiply and divide negative numbers correctly",
        "Apply sign rules: (-)(-)=(+), (+)(-)=(-)",
        "Handle negative numbers in substitution"
      ],
      "formulas": [
        "$(-a) \\times (-b) = ab$",
        "$(-a) \\times b = -ab$",
        "$(-a)^2 = a^2$",
        "$-a^2 = -(a^2)$"
      ],
      "explanation_ur": "منفی عدد میں منفی علامت (-) ہوتی ہے۔ دو منفی کی ضرب مثبت ہوتی ہے: (-3)\\times(-2) = +6۔ ایک مثبت اور ایک منفی کی ضرب منفی ہوتی ہے: (3)\\times(-2) = -6۔ بہت اہم: (-a)^2 = a^2 لیکن -a^2 = -(a^2)، یہ دونوں مختلف ہیں!",
      "key_terms": [
        {
          "en": "negative number",
          "ur": "منفی عدد"
        },
        {
          "en": "positive number",
          "ur": "مثبت عدد"
        },
        {
          "en": "sign rule",
          "ur": "علامت کا قاعدہ"
        }
      ],
      "worked_examples": [
        {
          "problem": "$(-5)^2 اور -5^2 میں فرق بتاؤ$",
          "steps": [
            {
              "step": 1,
              "description_ur": "(-5)^2 کا مطلب ہے (-5) \\times (-5)",
              "math": "$(-5)^2 = (-5)\\times(-5) = 25$",
              "result": "$25$"
            },
            {
              "step": 2,
              "description_ur": "-5^2 کا مطلب ہے -(5^2) یعنی پہلے مربع کرو پھر منفی لگاؤ",
              "math": "$-5^2 = -(5\\times5) = -25$",
              "result": "$-25$"
            },
            {
              "step": 3,
              "description_ur": "فرق: (-5)^2 = 25 لیکن -5^2 = -25",
              "math": "$(-5)^2 ≠ -5^2$",
              "result": "$brackets سے فرق پڑتا ہے!$"
            }
          ]
        }
      ],
      "board": "punjab",
      "grade": 10,
      "textbook_sources": [
        "prior_knowledge"
      ],
      "visual_need": "none",
