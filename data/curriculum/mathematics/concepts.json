      ],
      "formulas": [
        "$ax + b = c → x = (c - b) / a$"
      ],
      "explanation_ur": "خطی مساوات (linear equation) میں متغیر x کی طاقت 1 ہوتی ہے۔ حل کرنے کے لیے x کو ایک طرف اکیلا کرو۔ جب کوئی حد (term) مساوی نشان (=) کے دوسری طرف جاتی ہے تو اس کی علامت بدل جاتی ہے۔",
      "key_terms": [
        {
          "en": "linear equation",
          "ur": "خطی مساوات"
        },
        {
          "en": "solution",
          "ur": "حل"
        },
        {
          "en": "transpose",
          "ur": "منتقل کرنا"
        }
      ],
      "worked_examples": [
        {
          "problem": "$2x + 4 = 12 کو حل کرو$",
          "steps": [
            {
              "step": 1,
              "description_ur": "4 کو دوسری طرف لے جاؤ (علامت بدلے گی)",
              "math": "$2x = 12 - 4$",
              "result": "$2x = 8$"
            },
            {
              "step": 2,
              "description_ur": "دونوں طرف 2 سے تقسیم کرو",
              "math": "$x = 8/2$",
              "result": "$x = 4$"
            },
            {
              "step": 3,
              "description_ur": "جواب چیک کرو: 2(4) + 4 = 12 ✓",
