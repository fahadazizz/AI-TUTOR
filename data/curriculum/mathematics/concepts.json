      "concept_id": "prereq.algebra.square_root",
      "subject": "mathematics",
      "chapter": 0,
      "chapter_name": "Prerequisites (Class 9 & Earlier)",
      "name_en": "Square Roots",
      "name_ur": "جذر (مربع جڑ)",
      "difficulty": 2,
      "pedagogy_type": "conceptual",
      "learning_objectives": [
        "Find square roots of perfect squares",
        "Understand that √ gives both positive and negative values",
        "Simplify expressions involving square roots"
      ],
      "formulas": [
        "$√(a^2) = |a|$",
        "$If x^2 = k, then x = ±√k$"
      ],
      "explanation_ur": "جذر (square root) وہ عدد ہے جسے خود سے ضرب کریں تو اصل عدد آئے۔ مثلاً √25 = 5 کیونکہ 5\\times5 = 25۔ لیکن یاد رکھو: (-5)\\times(-5) = 25 بھی ہے! اس لیے اگر x^2 = 25 ہے تو x = +5 یا x = -5 دونوں ہو سکتے ہیں۔",
      "key_terms": [
        {
          "en": "square root",
          "ur": "جذر / مربع جڑ"
        },
        {
          "en": "perfect square",
          "ur": "کامل مربع"
        },
        {
          "en": "radical",
          "ur": "جذری نشان"
        }
      ],
      "worked_examples": [
        {
          "problem": "$اگر x^2 = 16 ہو تو x = ?$",
          "steps": [
            {
              "step": 1,
              "description_ur": "دونوں طرف جذر لو",
              "math": "$x = ±√16$",
              "result": "$x = ±4$"
            },
            {
              "step": 2,
              "description_ur": "دو جواب ہیں",
              "math": "$x = +4 یا x = -4$",
              "result": "$x = 4, x = -4$"
            },
            {
              "step": 3,
              "description_ur": "چیک: (4)^2 = 16 ✓ اور (-4)^2 = 16 ✓",
              "math": "$تصدیق$",
              "result": "$دونوں درست ہیں$"
            }
          ]
        }
      ],
