              "step": 5,
              "description_ur": "جذر لو",
              "math": "$x + 3 = ±√7$",
              "result": ""
            },
            {
              "step": 6,
              "description_ur": "x نکالو",
              "math": "$x = -3 ± √7$",
              "result": "$x = -3+√7 یا x = -3-√7$"
