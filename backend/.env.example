# ─── API Keys ───────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Ollama (Local Dev) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ─── LLM Provider Toggle ──────────────────────
# Options: "groq" | "ollama"
LLM_PROVIDER=ollama

# ─── Database ──────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# For Supabase Cloud, use the connection string from your dashboard

# ─── Application ───────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=debug
